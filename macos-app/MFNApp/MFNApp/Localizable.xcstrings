        }
      }
    },
    "Nach Inaktivität": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After Inactivity"
          }
        }
      }
    },
    "Nach Updates suchen …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates…"
          }
        }
      }
    },
    "Nach dem Entsperren alle Konten abgleichen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync All Accounts After Unlocking"
          }
        }
      }
    },
    "Nach dem nächsten Abgleich erscheinen hier die Wertpapiere.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The securities appear here after the next sync."
          }
        }
      }
    },
    "Nach oben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Up"
          }
        }
      }
    },
    "Nach unten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Down"
          }
        }
      }
    },
    "Nach „Weiter zur Bank“ öffnet sich ein Anmeldefenster mit der Seite von %@. Melde dich dort an wie im Browser. Manche Banken fragen stattdessen in ihrer App nach einer Freigabe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After “Continue to Bank”, a login window opens with the page of %@. Log in there as you would in a browser. Some banks ask for approval in their app instead."
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
    "Name bei der Bank: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name at the bank: %@"
          }
        }
      }
    },
    "Name enthält den Text; Groß-/Kleinschreibung und Akzente egal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name contains the text; case and accents do not matter."
