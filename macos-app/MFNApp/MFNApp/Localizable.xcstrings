    "„%@“ steht jetzt in der Seitenleiste.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is now in the sidebar."
          }
        }
      }
    },
    "„Automatisch“ folgt der Einstellung in den Systemeinstellungen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Automatic” follows the setting in System Settings."
          }
        }
      }
    },
    "„Immer erlauben“ gibt es nur für Programme mit Entwickler-Signatur, die MFNs Helfer direkt starten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Always Allow” is only available for programs with a developer signature that start MFN’s helper directly."
          }
        }
      }
    },
    "„Schwarz“ ist das Symbol der App. Die anderen ersetzen das Dock-Symbol, solange MFN läuft; im Finder bleibt das schwarze sichtbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Black” is the app’s icon. The others replace the Dock icon while MFN is running; the black one stays visible in the Finder."
          }
        }
      }
    },
