          }
        }
      }
    },
    "Neueste Umsätze": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest Transactions"
          }
        }
      }
    },
    "Nicht freigegebene Konten gibt es für den Assistenten nicht. Neue Konten sind freigegeben, bis du sie hier abwählst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts that are not shared do not exist for the assistant. New accounts are shared until you deselect them here."
          }
