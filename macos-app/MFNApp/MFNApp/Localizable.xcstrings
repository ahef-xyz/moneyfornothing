    "Noch keine Ausgaben in diesem Monat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No expenses this month yet."
          }
        }
      }
    },
    "Noch keine Bank": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Bank Yet"
          }
        }
      }
    },
    "Noch keine Bank. „Bank hinzufügen …“ im Menü „MoneyForNothing“ oder „Konten“ (⇧⌘N).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bank yet. Use “Add Bank…” in the “MoneyForNothing” or “Accounts” menu (⇧⌘N)."
          }
        }
      }
    },
    "Noch keine Kategorie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No category yet"
          }
        }
      }
    },
    "Noch keine Konten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No accounts yet."
          }
        }
      }
    },
    "Noch keine Regeln. Wähle einen Umsatz und dann „Regel erstellen …“ (⇧⌘K).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules yet. Select a transaction and then “Create Rule…” (⇧⌘K)."
          }
        }
      }
    },
    "Noch keine Umsätze.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
