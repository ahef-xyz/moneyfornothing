      }
    },
    "Die Bank konnte nicht im Schlüsselbund vermerkt werden: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank could not be noted in the keychain: %@"
          }
        }
      }
    },
    "Die Bank liefert für diese Position keinen Einstandskurs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank does not provide a cost basis for this holding"
          }
        }
      }
    },
    "Die Bank liefert für diese Position keinen Einstandskurs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank does not provide a cost basis for this holding."
          }
        }
      }
    },
    "Die Buchung ist oben herausgerechnet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The booking is excluded above."
          }
        }
      }
    },
    "Die CSV-Datei konnte nicht gesichert werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CSV file could not be saved."
          }
        }
      }
    },
    "Die Datei enthält keine lesbaren gebuchten Umsätze.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file contains no readable booked transactions."
          }
        }
      }
    },
    "Die Datei ist zu groß (mehr als 50 MB).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large (more than 50 MB)."
          }
        }
      }
    },
    "Die Datei konnte nicht gelesen werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read."
          }
        }
      }
    },
    "Die Datei ließ sich nicht lesen oder schreiben. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read or written. %@"
          }
        }
      }
    },
    "Die Daten aus der Sicherung vom %@ sind jetzt aktiv.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data from the backup of %@ is now active."
          }
        }
      }
    },
    "Die Datenbank ist nicht geöffnet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database is not open."
          }
        }
      }
    },
    "Die Datenbank konnte nicht geöffnet werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database could not be opened."
          }
        }
      }
    },
    "Die Datenbank ließ sich nicht lesen oder schreiben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database could not be read or written."
