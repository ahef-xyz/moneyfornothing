    "Die Anmeldung hat nicht geklappt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login did not work."
          }
        }
      }
    },
    "Die Anmeldung läuft direkt bei deiner Bank.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login takes place directly at your bank."
          }
        }
      }
    },
    "Die Anmeldung wurde abgebrochen oder hat zu lange gedauert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login was cancelled or took too long."
          }
        }
      }
    },
    "Die Anmeldung wurde abgelehnt. Bitte die Zugangsdaten prüfen. MFN versucht es nicht automatisch erneut, damit der Zugang nicht gesperrt wird.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login was rejected. Please check your login details. MFN does not retry automatically so that your access is not locked."
          }
        }
      }
    },
    "Die App ist nicht korrekt signiert (Schlüsselbund-Berechtigung fehlt).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not signed correctly (keychain entitlement is missing)."
          }
        }
      }
    },
    "Die Auswahl enthält Umsätze aus dem Abgleich mit der Bank. Entfernt werden können nur importierte Umsätze.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection contains transactions from the bank sync. Only imported transactions can be removed."
          }
        }
      }
    },
    "Die Bank hat keine Konten gemeldet. Die Verbindung kann trotzdem gespeichert werden; neue Konten erscheinen beim nächsten Abgleich.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank reported no accounts. You can still save the connection; new accounts appear at the next sync."
          }
        }
      }
    },
    "Die Bank ist gerade nicht erreichbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank is not reachable right now."
          }
        }
      }
    },
    "Die Bank konnte nicht entfernt werden: %@": {
