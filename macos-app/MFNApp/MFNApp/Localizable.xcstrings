    },
    "„%@“ in „%@“ übernehmen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge “%1$@” into “%2$@”?"
          }
        }
      }
    },
    "„%@“ ist dein eigener Eintrag. Er lässt sich nicht wiederherstellen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is your own entry. It cannot be restored."
          }
        }
      }
    },
    "„%@“ ist erledigt, entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is done, remove"
          }
        }
      }
    },
    "„%@“ kommt noch, wieder einrechnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is still to come, count again"
          }
        }
      }
    },
    "„%@“ möchte deine Finanzdaten lesen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” wants to read your financial data"
