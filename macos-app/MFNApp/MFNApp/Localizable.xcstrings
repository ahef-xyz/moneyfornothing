          "stringUnit": {
            "state": "translated",
            "value": "The bank could not be removed: %@"
          }
        }
      }
    },
    "Die Bank konnte nicht gespeichert werden (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bank could not be saved (%@)."
