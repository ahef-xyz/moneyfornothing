    "„%@“ (Web-Banking) zu „%@“ (FinTS). Bis „Zusammenführen“ bestätigt ist, ändert sich nichts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (web banking) to “%2$@” (FinTS). Nothing changes until “Merge” is confirmed."
          }
        }
      }
    },
    "„%@“ (Web-Banking) …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” (Web Banking)…"
          }
        }
      }
    },
