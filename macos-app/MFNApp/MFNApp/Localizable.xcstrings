      }
    },
    "Die Umsätze konnten nicht gespeichert werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transactions could not be saved."
          }
        }
      }
    },
    "Die Umsätze werden aus MFN gelöscht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transactions will be deleted from MFN."
          }
        }
      }
    },
    "Die Währung lässt sich nicht ändern, solange das Konto Umsätze hat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The currency cannot be changed while the account has transactions."
          }
        }
      }
    },
    "Die Währung lässt sich nicht ändern, solange das Konto Umsätze hat: ihre Beträge sind in dieser Währung gespeichert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The currency cannot be changed while the account has transactions: their amounts are stored in this currency."
          }
        }
      }
    },
    "Die Zugangsdaten konnten nicht im Schlüsselbund gespeichert werden: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login details could not be saved to the keychain: %@"
          }
        }
      }
    },
    "Die angezeigten importierten Umsätze entfernen (fragt nach)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the imported transactions shown (asks first)"
          }
        }
      }
    },
    "Die automatische Kategorisierung läuft weiter. Deine Entscheidungen hier warten nicht auf sie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic categorization continues. Your decisions here do not wait for it."
          }
        }
      }
    },
    "Die beiden Verbindungen gehören zu verschiedenen Banken.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two connections belong to different banks."
          }
        }
      }
    },
    "Die bisherigen Daten liegen verschlüsselt als Kopie im Datenordner; du kannst sie löschen, wenn alles stimmt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previous data is kept as an encrypted copy in the data folder; you can delete it once everything looks right."
          }
        }
      }
    },
    "Die geplante Buchung entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the planned booking"
          }
        }
      }
    },
    "Die geplante Buchung konnte nicht entfernt werden: %@": {
      "localizations": {
        "en": {
